# --- Option A: Neon (or any cloud) PostgreSQL ---
# Paste your Neon connection string here. Get it from the Neon dashboard:
# Project -> Connect -> "Connection string" (use the "Pooled connection" one).
# It must end with ?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Option B: Local PostgreSQL ---
# Used only if DATABASE_URL above is not set.
DB_HOST=localhost
DB_NAME=ml_project
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# --- Optional: force SQLite (skips Postgres entirely) ---
# DB_ENGINE=sqlite
